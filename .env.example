# Runtime
NODE_ENV=development
FRONTEND_PORT=3000
BACKEND_PORT=3001
AI_SERVICE_PORT=8000

# PostgreSQL
POSTGRES_DB=ai_marks
POSTGRES_USER=ai_marks
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://ai_marks:change-me@postgres:5432/ai_marks?schema=public

# Redis and queues
REDIS_URL=redis://redis:6379

# Authentication (replace with strong secrets outside development)
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Object storage
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Service URLs
AI_SERVICE_URL=http://ai-service:8000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Observability
SENTRY_DSN=

