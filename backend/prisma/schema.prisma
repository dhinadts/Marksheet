  markSheet     MarkSheet                 @relation(fields: [markSheetId], references: [id], onDelete: Restrict)
  assignedTo    User?                     @relation("VerificationAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  completedBy   User?                     @relation("VerificationCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
