}

model VerificationItem {
  id                    String              @id @default(uuid()) @db.Uuid
  tenantId              String              @map("tenant_id") @db.Uuid
  verificationSessionId String              @map("verification_session_id") @db.Uuid
  extractedMarkId       String              @map("extracted_mark_id") @db.Uuid
  selectedMarkValueId   String?             @map("selected_mark_value_id") @db.Uuid
  status                VerificationStatus  @default(PENDING)
  reason                String?
  reviewedAt            DateTime?           @map("reviewed_at") @db.Timestamptz(6)
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  verificationSession   VerificationSession @relation(fields: [verificationSessionId], references: [id], onDelete: Cascade)
  extractedMark         ExtractedMark       @relation(fields: [extractedMarkId], references: [id], onDelete: Restrict)
  selectedMarkValue     MarkValue?          @relation(fields: [selectedMarkValueId], references: [id], onDelete: Restrict)

  @@unique([tenantId, verificationSessionId, extractedMarkId])
  @@index([tenantId, status])
  @@map("verification_items")
}

model CalculationResult {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
