model ExtractedMark {
  id                  String             @id @default(uuid()) @db.Uuid
  tenantId            String             @map("tenant_id") @db.Uuid
  markSheetId         String             @map("mark_sheet_id") @db.Uuid
  markingSchemeItemId String             @map("marking_scheme_item_id") @db.Uuid
  questionId          String             @map("question_id") @db.Uuid
  questionPartId      String?            @map("question_part_id") @db.Uuid
  sourceImageId       String?            @map("source_image_id") @db.Uuid
  aiModelVersionId    String?            @map("ai_model_version_id") @db.Uuid
  rawText             String?            @map("raw_text") @db.VarChar(100)
  extractedValue      Decimal?           @map("extracted_value") @db.Decimal(7, 2)
  confidence          Decimal?           @db.Decimal(5, 4)
  boundingBox         Json?              @map("bounding_box") @db.JsonB
  extractionStatus    ExtractionStatus   @default(PENDING) @map("extraction_status")
  verificationStatus  VerificationStatus @default(PENDING) @map("verification_status")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  markSheet           MarkSheet          @relation(fields: [markSheetId], references: [id], onDelete: Cascade)
  markingSchemeItem   MarkingSchemeItem  @relation(fields: [markingSchemeItemId], references: [id], onDelete: Restrict)
  question            Question           @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionPart        QuestionPart?      @relation(fields: [questionPartId], references: [id], onDelete: Restrict)
  sourceImage         MarkSheetImage?    @relation(fields: [sourceImageId], references: [id], onDelete: SetNull)
  aiModelVersion      AiModelVersion?    @relation(fields: [aiModelVersionId], references: [id], onDelete: SetNull)
  values              MarkValue[]
  verificationItems   VerificationItem[]

  @@unique([tenantId, markSheetId, markingSchemeItemId])
  @@index([tenantId, extractionStatus, verificationStatus])
  @@map("extracted_marks")
}

model MarkValue {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  extractedMarkId   String             @map("extracted_mark_id") @db.Uuid
  value             Decimal            @db.Decimal(7, 2)
  source            MarkValueSource
  reason            String?
  createdById       String?            @map("created_by_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  extractedMark     ExtractedMark      @relation(fields: [extractedMarkId], references: [id], onDelete: Restrict)
  createdBy         User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  verificationItems VerificationItem[]

  @@index([tenantId, extractedMarkId, createdAt])
  @@map("mark_values")
}

model VerificationSession {
  id            String                    @id @default(uuid()) @db.Uuid
  tenantId      String                    @map("tenant_id") @db.Uuid
  markSheetId   String                    @map("mark_sheet_id") @db.Uuid
  assignedToId  String?                   @map("assigned_to_id") @db.Uuid
  completedById String?                   @map("completed_by_id") @db.Uuid
  status        VerificationSessionStatus @default(OPEN)
  lockVersion   Int                       @default(0) @map("lock_version")
  startedAt     DateTime                  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime?                 @map("completed_at") @db.Timestamptz(6)
